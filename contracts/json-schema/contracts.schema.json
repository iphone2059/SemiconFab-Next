{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semiconfab:next:contracts:v1",
  "title": "SemiconFab Next initial independent simulation contracts",
  "description": "Integer quantities encoded as decimal strings. Only synthetic independent model v1 is implemented.",
  "oneOf": [
    {
      "$ref": "#/$defs/CreateRunRequest"
    }
  ],
  "$defs": {
    "FabDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabId",
        "code"
      ],
      "properties": {
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "SiteDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId",
        "code",
        "templateHash",
        "fabs"
      ],
      "properties": {
        "siteId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "templateHash": {
          "type": "string"
        },
        "fabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FabDto"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    },
    "FabScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabId",
        "code",
        "lotCount",
        "processTimeUs"
      ],
      "properties": {
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "lotCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "processTimeUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "ScenarioDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "siteId",
        "mode",
        "masterSeed",
        "durationUs",
        "warmupUs",
        "fabs"
      ],
      "properties": {
        "contractVersion": {
          "type": "integer",
          "const": 1
        },
        "siteId": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "type": "string",
          "const": "INDEPENDENT"
        },
        "masterSeed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "durationUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "warmupUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "fabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FabScenario"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    },
    "CreateRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario"
      ],
      "properties": {
        "scenario": {
          "$ref": "#/$defs/ScenarioDefinition"
        }
      }
    },
    "FabExecutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabId",
        "code",
        "status",
        "completedLots",
        "totalLots",
        "simulationTimeUs",
        "traceHash",
        "error"
      ],
      "properties": {
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "completedLots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "totalLots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "simulationTimeUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "traceHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RunSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "siteId",
        "status",
        "version",
        "createdAtUtc",
        "executions"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "siteId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "createdAtUtc": {
          "type": "string"
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FabExecutionSummary"
          }
        }
      }
    },
    "SimulationEventDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabId",
        "entityId",
        "kind",
        "simulationTimeUs",
        "sequence"
      ],
      "properties": {
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "entityId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "simulationTimeUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "FabSimulationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabId",
        "completedLots",
        "totalLots",
        "simulationTimeUs",
        "busyTimeUs",
        "traceHash",
        "events"
      ],
      "properties": {
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "completedLots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "totalLots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "simulationTimeUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "busyTimeUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "traceHash": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SimulationEventDto"
          }
        }
      }
    },
    "RunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "fabs"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "fabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FabSimulationResult"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    },
    "SiteKpiDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId",
        "runId",
        "completedLots",
        "totalLots",
        "totalBusyTimeUs",
        "observationEndUs",
        "fabCount"
      ],
      "properties": {
        "siteId": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "completedLots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "totalLots": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "totalBusyTimeUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "observationEndUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "fabCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "CatalogEntryDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "vendor",
        "model",
        "category",
        "domain",
        "conformanceLevel",
        "completenessPct",
        "missingFields",
        "record",
        "legacy",
        "price"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "format": "uuid"
        },
        "vendor": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "enum": [
            "FAB",
            "OSAT"
          ]
        },
        "conformanceLevel": {
          "type": "string"
        },
        "completenessPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record": {
          "type": "object",
          "additionalProperties": true
        },
        "legacy": {
          "type": "object",
          "additionalProperties": true
        },
        "price": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "CatalogSnapshotDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "importId",
        "source",
        "entries"
      ],
      "properties": {
        "contractVersion": {
          "type": "integer",
          "const": 1
        },
        "importId": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogEntryDto"
          }
        }
      }
    },
    "CatalogCategoryDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "domain",
        "count"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CatalogPageDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importId",
        "totalCount",
        "matchedCount",
        "categories",
        "items"
      ],
      "properties": {
        "importId": {
          "type": "string"
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedCount": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogCategoryDto"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogEntryDto"
          }
        }
      }
    },
    "CommandRecoveryDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId",
        "fabId",
        "commandId",
        "revision",
        "outcome",
        "occurredAt",
        "terminal"
      ],
      "properties": {
        "siteId": {
          "type": "string",
          "format": "uuid"
        },
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string"
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "description": "Authoritative command state inside the durable retention window (Development defaults: terminal TTL 5 minutes, at most 512 terminal commands and 4096 journal events per Site). Commands outside the window are not recoverable: GET /api/v1/commands/{commandId} returns 404 instead of guessing."
    },
    "CommandRecoveryListDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "latestSequence",
        "commands"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "latestSequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandRecoveryDto"
          }
        }
      },
      "description": "Authoritative FAB-scoped command listing used after a browser refresh or a severe replay gap. epoch/latestSequence are the durable per-Site journal cursor; commands outside the retention window are omitted."
    },
    "CommandJournalEventDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "fabId",
        "commandId",
        "revision",
        "outcome",
        "occurredAt"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "fabId": {
          "type": "string",
          "format": "uuid"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string"
        }
      },
      "description": "One durable journal event. sequence is the per-Site monotonic cursor component; SSE ids are the string form {epoch}:{sequence}."
    },
    "CommandJournalPageDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "hasGap",
        "firstRetainedSequence",
        "latestSequence",
        "events"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "hasGap": {
          "type": "boolean"
        },
        "firstRetainedSequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "latestSequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandJournalEventDto"
          }
        }
      },
      "description": "A paged journal replay window. hasGap=true means the requested afterSequence cannot be served exactly (retention trim, epoch replacement or cursor ahead of the journal); clients must reconcile authoritative command state via the commands listing. Events outside the retention window are never replayed."
    },
    "CommandDirtyDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "droppedCount",
        "epoch",
        "sequence",
        "occurredAt"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "droppedCount": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "occurredAt": {
          "type": "string"
        }
      },
      "description": "SSE event: dirty control frame (no id line, not journaled). The retained journal may be incomplete (reason retention-trim|epoch-replaced|store-fault): the client MUST reconcile authoritative command state and must not guess."
    }
  }
}
