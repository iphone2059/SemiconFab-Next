<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>Fab.Api</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../fab_shared/fab_shared.csproj" />
    <ProjectReference Include="../site_service/site_service.csproj" />
    <ProjectReference Include="../identity_service/identity_service.csproj" />
    <ProjectReference Include="../orchestration_service/orchestration_service.csproj" />
    <ProjectReference Include="../analytics_service/analytics_service.csproj" />
  </ItemGroup>
</Project>
