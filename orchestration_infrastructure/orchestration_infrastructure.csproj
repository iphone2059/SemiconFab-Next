    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RootNamespace>Fab.Orchestration.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../orchestration_application/orchestration_application.csproj" />
    <ProjectReference Include="../orchestration_domain/orchestration_domain.csproj" />
    <ProjectReference Include="../simulation_runtime/simulation_runtime.csproj" />
  </ItemGroup>
</Project>
